# Nukopijuokite į .env ir užpildykite. .env NIEKADA nekelkite į GitHub.

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bendra paslaptis tarp ElevenLabs agento ir Edge Functions (header x-agent-secret)
AGENT_SECRET=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Firecrawl
FIRECRAWL_API_KEY=

# Twilio (telefono numeris ir SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
